# Server-only settings. Never commit real values. Preview must use its own DB/key set.
NOTTA_SERVICE_ENABLED=yes
# Enable only after the additive svc_intake* migration and runtime grants.
NOTTA_INTAKE_ENABLED=no
# Only the dedicated public test site enables this banner and search exclusion.
NOTTA_PUBLIC_SANDBOX=no
NOTTA_DATABASE_BACKEND=postgres
NOTTA_DATABASE_URL=
NOTTA_PUBLIC_ORIGIN=
NOTTA_COMMERCIAL_HOST_APPROVED=yes
NOTTA_AUTH_SECRET=
RESEND_API_KEY=
NOTTA_MAIL_VERIFIED=no
GEMINI_API_KEY=
NOTTA_AI_ENABLED=no
# Search uses Gemini 2.5 Flash only; verify cumulative tool-input costs and display before enabling.
NOTTA_SEARCH_LIMIT_VERIFIED=no
# Use an isolated Stripe sandbox and a restricted key for Preview.
STRIPE_ENVIRONMENT=sandbox
STRIPE_RESTRICTED_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NOTTA_BILLING_ENABLED=no
NOTTA_SELLER_PHONE=090-9325-5945
NOTTA_LEGAL_VERIFIED=no
